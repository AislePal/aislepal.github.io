    .tl.in-view .tl-step:nth-child(2) .tl-day { animation: tl-fade 0.50s var(--ap-ease) 0.57s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-day { animation: tl-fade 0.50s var(--ap-ease) 0.84s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-day { animation: tl-fade 0.50s var(--ap-ease) 1.11s both; }
  }
