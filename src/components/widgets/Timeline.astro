<style is:global>

/* ── Design tokens ── */
.tl {
  --ap-teal:       #00ABB8;
  --ap-teal-50:    #f0fbfc;
  --ap-teal-100:   #d0f4f7;
  --ap-teal-600:   #0099a4;
  --ap-teal-700:   #005c61;
  --ap-border:     #e5e7eb;
  --ap-bg-2:       #f9fafb;
  --ap-ink:        #101010;
  --ap-fg-2:       rgba(16,16,16,0.6);
  --ap-r-sm:       6px;
  --ap-r-lg:       12px;
  --ap-r-pill:     999px;
  --ap-shadow-md:  0 4px 6px rgba(0,0,0,.07), 0 2px 4px rgba(0,0,0,.06);
  --ap-ease:       cubic-bezier(.2,.7,.2,1);
  --ap-ease-out:   cubic-bezier(0,.55,.45,1);
  --ap-fw-semibold: 600;
  --ap-fs-base:    1rem;
  --ap-fs-sm:      0.875rem;
  --ap-lh-loose:   1.6;
  --ap-tracking-tight: -0.01em;
}

/* ── Timeline container ── */
.tl {
  position: relative;
  padding: clamp(20px,3vw,36px) clamp(16px,4vw,48px);
  cursor: default;
  -webkit-user-select: none; user-select: none;
  border-radius: 16px;
  /* border: 1px solid var(--ap-border); */
  background: #fff;
}

/* ── Rail (spine line) ── */
.tl-rail { position: absolute; background: var(--ap-border); }
.tl-rail-fill {
  position: absolute; top: 0; left: 0;
  transition: height 0.42s var(--ap-ease), width 0.42s var(--ap-ease);
}

/* ── Traveling marker ── */
.tl-marker {
  position: absolute;
  width: 18px; height: 18px; border-radius: 50%;
  background: var(--ap-teal);
  border: 3px solid #fff;
  box-shadow: 0 0 0 4px rgba(0,171,184,0.2);
  transform: translate(-50%, -50%);
  z-index: 5; pointer-events: none;
  transition: top 0.36s var(--ap-ease), left 0.36s var(--ap-ease);
}
.tl-marker::before {
  content: "";
  position: absolute; inset: -8px; border-radius: 50%;
  border: 1.5px solid rgba(0,171,184,0.3);
  animation: tl-ripple 2s var(--ap-ease-out) infinite;
}
@keyframes tl-ripple {
  0%   { transform: scale(0.55); opacity: 1; }
  70%  { transform: scale(1.75); opacity: 0; }
  100% { transform: scale(1.75); opacity: 0; }
}
@media (prefers-reduced-motion: reduce) {
  .tl-marker::before { animation: none; }
}

/* ── Node dot ── */
.tl-node {
  width: 16px; height: 16px; border-radius: 50%;
  background: #fff; border: 2px solid var(--ap-border);
  position: relative; flex-shrink: 0;
  transition: border-color 0.35s var(--ap-ease);
}
.tl-node span {
  position: absolute; inset: 3px; border-radius: 50%;
  background: var(--ap-teal);
  opacity: 0; transform: scale(0.3);
  transition: opacity 0.35s var(--ap-ease), transform 0.35s var(--ap-ease);
}
.tl.in-view .tl-node { border-color: var(--ap-teal); }
.tl-step.is-active .tl-node span { opacity: 1; transform: scale(1); }

/* ── Connector line ── */
.tl-conn {
  background: var(--ap-border);
  transition: background 0.25s var(--ap-ease);
  flex-shrink: 0;
}
.tl-step.is-active .tl-conn { background: var(--ap-teal); }

/* ── Card ── */
.tl-card {
  background: var(--ap-bg-2);
  border: 1.5px solid var(--ap-border);
  border-radius: var(--ap-r-lg);
  transition:
    border-color 0.25s var(--ap-ease),
    background   0.25s var(--ap-ease),
    box-shadow   0.30s var(--ap-ease),
    transform    0.30s var(--ap-ease);
}
.tl-card.is-active {
  border-color: var(--ap-teal);
  background: #fff;
  box-shadow: var(--ap-shadow-md);
}
.tl-card__icon {
  border-radius: var(--ap-r-sm);
  background: var(--ap-teal-50); color: var(--ap-teal-700);
  display: grid; place-items: center;
  transition: background 0.25s var(--ap-ease);
}
.tl-card.is-active .tl-card__icon { background: var(--ap-teal-100); }
.tl-card__icon svg { display: block; }

/* ── Day label ── */
.tl-day {
  display: inline-flex;
  align-items: center;
  font-size: 10px; font-weight: var(--ap-fw-semibold);
  letter-spacing: 0.08em; text-transform: uppercase;
  color: var(--ap-teal-700);
  background: var(--ap-teal-50);
  border: 1px solid rgba(0,171,184,0.2);
  border-radius: var(--ap-r-pill);
  line-height: 1;
  padding: 8px 10px; white-space: nowrap;
  transition: background 0.25s var(--ap-ease), border-color 0.25s var(--ap-ease), color 0.25s var(--ap-ease);
}
.tl-step.is-active .tl-day {
  background: var(--ap-teal-100);
  border-color: rgba(0,171,184,0.45);
}
.tl-card__name {
  font-weight: var(--ap-fw-semibold);
  letter-spacing: var(--ap-tracking-tight); color: var(--ap-ink); margin: 0;
}
.tl-card__desc {
  line-height: var(--ap-lh-loose); color: var(--ap-fg-2); margin: 0; text-wrap: pretty;
}


/* ═══════════════════════════════════════════════════════
   PORTRAIT — vertical spine, node+day above each card
   ═══════════════════════════════════════════════════════ */
@media (orientation: portrait) {

  .tl-rail {
    left: 50%; transform: translateX(-1px);
    top: clamp(20px,3vw,36px); bottom: clamp(20px,3vw,36px);
    width: 2px;
  }
  .tl-rail-fill {
    width: 100%; height: 0%;
    background: linear-gradient(180deg, var(--ap-teal), var(--ap-teal-700));
  }

  .tl-marker { left: 50%; top: 8%; }

  .tl-steps { display: flex; flex-direction: column; }

  .tl-step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    /* top padding = step spacing (16px) + header height (~26px) + gap (10px) */
    padding: 52px 0 16px;
    gap: 6px;
  }

  /* Header: absolutely positioned with node centered on the spine */
  .tl-step-header {
    position: absolute;
    top: 16px;
    /* node is 16px wide; left edge at 50%−8px → node center = 50% */
    left: calc(50% - 8px);
    display: flex;
    align-items: center;
    gap: 8px;
    z-index: 2;
  }

  .tl-node-wrap { flex-shrink: 0; }

  /* Connector: short vertical line between header and card */
  .tl-conn {
    align-self: center;
    width: 0px;
    height: 14px;
  }

  /* Card: full width */
  .tl-card { width: 100%; padding: clamp(14px,2vw,22px); }
