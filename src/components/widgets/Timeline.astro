/* ── Shared keyframes ── */
@keyframes tl-from-l { from { opacity:0; transform: translateX(-24px); } to { opacity:1; transform: none; } }
@keyframes tl-from-r { from { opacity:0; transform: translateX( 24px); } to { opacity:1; transform: none; } }
@keyframes tl-rise   { from { opacity:0; transform: translateY( 18px); } to { opacity:1; transform: none; } }
@keyframes tl-drop   { from { opacity:0; transform: translateY(-18px); } to { opacity:1; transform: none; } }
@keyframes tl-pop    { from { opacity:0; transform: scale(0.3);        } to { opacity:1; transform: scale(1); } }
@keyframes tl-pop-a  { from { opacity:0; transform: translate(-50%,-50%) scale(0.3); } to { opacity:1; transform: translate(-50%,-50%); } }
@keyframes tl-fade   { from { opacity:0; } to { opacity:1; } }

