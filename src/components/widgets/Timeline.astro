(function () {
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  function initTL(root) {
    var rail      = root.querySelector('.tl-rail');
    var fill      = root.querySelector('.tl-rail-fill');
    var marker    = root.querySelector('.tl-marker');
    var steps     = Array.from(root.querySelectorAll('.tl-step'));
    var nodeWraps = steps.map(function (s) { return s.querySelector('.tl-node-wrap'); });
    var cards     = steps.map(function (s) { return s.querySelector('.tl-card'); });

    var activeIdx = 0;
    var revealed  = false;

    function landscape() {
      return window.matchMedia('(orientation: landscape)').matches;
    }

    function midpt(el) {
      var r = el.getBoundingClientRect();
      return { x: r.left + r.width * 0.5, y: r.top + r.height * 0.5 };
    }

    function setActive(i) {
      activeIdx = ((i % 4) + 4) % 4;
      steps.forEach(function (s, idx) { s.classList.toggle('is-active', idx === activeIdx); });
      cards.forEach(function (c, idx) { c.classList.toggle('is-active', idx === activeIdx); });

      if (!revealed) return;

      var nc = midpt(nodeWraps[activeIdx]);
      var tr = root.getBoundingClientRect();
      var rr = rail.getBoundingClientRect();

      if (landscape()) {
        var xPct = rr.width > 0 ? (nc.x - rr.left) / rr.width * 100 : 0;
        xPct = Math.max(0, Math.min(100, xPct));
        marker.style.top  = '50%';
        marker.style.left = ((nc.x - tr.left) / tr.width * 100) + '%';
        fill.style.width  = xPct + '%';
        fill.style.height = '100%';
      } else {
        var yPct = rr.height > 0 ? (nc.y - rr.top) / rr.height * 100 : 0;
        yPct = Math.max(0, Math.min(100, yPct));
        marker.style.left = '50%';
        marker.style.top  = ((nc.y - tr.top) / tr.height * 100) + '%';
        fill.style.height = yPct + '%';
        fill.style.width  = '100%';
      }
    }

    function nearest(cx, cy) {
      var ls = landscape();

      if (!ls) {
        /* Portrait: which step's bounding box contains the Y position?
           This gives each card its full height as a hit target. */
        for (var i = 0; i < steps.length; i++) {
          var sr = steps[i].getBoundingClientRect();
          if (cy >= sr.top && cy <= sr.bottom) return i;
        }
      }

      /* Landscape: nearest node by X. Portrait fallback: nearest node by Y. */
      var best = 0, bestD = Infinity;
      nodeWraps.forEach(function (nw, idx) {
        var c = midpt(nw);
        var d = ls ? Math.abs(cx - c.x) : Math.abs(cy - c.y);
        if (d < bestD) { bestD = d; best = idx; }
      });
      return best;
    }

    function handlePointer(cx, cy) {
      if (!revealed) return;
      var n = nearest(cx, cy);
      if (n !== activeIdx) setActive(n);
    }

    root.addEventListener('mousemove', function (e) {
      handlePointer(e.clientX, e.clientY);
    });

    root.addEventListener('touchstart', function (e) {
      if (e.touches.length === 0) return;
      handlePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    root.addEventListener('touchmove', function (e) {
      if (e.touches.length === 0) return;
      handlePointer(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    root.addEventListener('keydown', function (e) {
      if (!revealed) return;
      if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  { e.preventDefault(); setActive(activeIdx + 1); }
      if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')    { e.preventDefault(); setActive(activeIdx - 1); }
    });

    window.addEventListener('resize', function () {
      if (revealed) setTimeout(function () { setActive(activeIdx); }, 120);
    });

    function reveal() {
      if (revealed) return;
      revealed = true;
      root.classList.add('in-view');
      setTimeout(function () { setActive(0); }, reduce ? 0 : 420);
    }

    function inVp() {
      var r = root.getBoundingClientRect();
      var h = window.innerHeight || document.documentElement.clientHeight;
      return r.top < h * 0.88 && r.bottom > 0;
    }

    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (es) {
        es.forEach(function (e) { if (e.isIntersecting) { reveal(); io.disconnect(); } });
      }, { threshold: 0.18 });
      io.observe(root);
    }

    function check() { if (inVp()) reveal(); }
    window.addEventListener('scroll', check, { passive: true });
    check();
    setTimeout(check, 80);
    if (reduce) reveal();
  }

  function boot() {
    document.querySelectorAll('[data-tl]').forEach(initTL);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
