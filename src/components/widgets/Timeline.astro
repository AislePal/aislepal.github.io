    position: absolute;
    top: calc(50% + 22px); left: 6px; right: 6px;
  }
  .tl-step:nth-child(odd) .tl-conn {
    position: absolute;
    top: calc(50% + 10px);
    left: 50%; transform: translateX(-50%);
    width: 1.5px; height: 12px;
  }

  /* Even steps (Integration, Deployment): card ABOVE spine */
  .tl-step:nth-child(even) .tl-card {
    position: absolute;
    bottom: calc(50% + 22px); left: 6px; right: 6px;
  }
  .tl-step:nth-child(even) .tl-conn {
    position: absolute;
    bottom: calc(50% + 10px);
    left: 50%; transform: translateX(-50%);
    width: 1.5px; height: 12px;
  }

  /* Card dimensions */
  .tl-card { padding: clamp(12px,1.4vw,18px); }
  .tl-card__icon { width: 30px; height: 30px; margin-bottom: 8px; }
  .tl-card__icon svg { width: 15px; height: 15px; }
  .tl-card__name { font-size: var(--ap-fs-sm); margin-bottom: 4px; }
  .tl-card__desc { font-size: 12px; }

  /* Day label: opposite side of spine from card — increased gap to 24px */
  .tl-day { font-size: 9px; }
  .tl-step:nth-child(odd)  .tl-day {
    position: absolute;
    bottom: calc(50% + 24px);
    left: 50%; transform: translateX(-50%);
  }
  .tl-step:nth-child(even) .tl-day {
    position: absolute;
    top: calc(50% + 24px);
    left: 50%; transform: translateX(-50%);
  }

  /* Active: nudge toward spine */
  .tl-step:nth-child(odd)  .tl-card.is-active { transform: translateY(-3px); }
  .tl-step:nth-child(even) .tl-card.is-active { transform: translateY(3px);  }

  /* ── Scroll reveal (landscape) ── */
  @media (prefers-reduced-motion: no-preference) {
    .tl-step:nth-child(odd)  .tl-card { opacity: 0; transform: translateY(18px);  }
    .tl-step:nth-child(even) .tl-card { opacity: 0; transform: translateY(-18px); }
    .tl-node-wrap { opacity: 0; transform: translate(-50%,-50%) scale(0.3); }
    .tl-conn { opacity: 0; }

    .tl.in-view .tl-step:nth-child(1) .tl-card     { animation: tl-rise 0.50s var(--ap-ease) 0.18s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-card     { animation: tl-drop 0.50s var(--ap-ease) 0.32s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-card     { animation: tl-rise 0.50s var(--ap-ease) 0.46s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-card     { animation: tl-drop 0.50s var(--ap-ease) 0.60s both; }

    .tl.in-view .tl-step:nth-child(1) .tl-node-wrap { animation: tl-pop-a 0.38s var(--ap-ease) 0.14s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-node-wrap { animation: tl-pop-a 0.38s var(--ap-ease) 0.28s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-node-wrap { animation: tl-pop-a 0.38s var(--ap-ease) 0.42s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-node-wrap { animation: tl-pop-a 0.38s var(--ap-ease) 0.56s both; }

    .tl.in-view .tl-step:nth-child(1) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.22s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.36s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.50s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.64s both; }

    .tl-step .tl-day { opacity: 0; }
    .tl.in-view .tl-step:nth-child(1) .tl-day { animation: tl-fade 0.35s var(--ap-ease) 0.22s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-day { animation: tl-fade 0.35s var(--ap-ease) 0.36s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-day { animation: tl-fade 0.35s var(--ap-ease) 0.50s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-day { animation: tl-fade 0.35s var(--ap-ease) 0.64s both; }
