    .tl.in-view .tl-step:nth-child(4) .tl-card { animation: tl-rise 0.50s var(--ap-ease) 1.06s both; }

    .tl.in-view .tl-step:nth-child(1) .tl-node-wrap { animation: tl-pop 0.40s var(--ap-ease) 0.20s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-node-wrap { animation: tl-pop 0.40s var(--ap-ease) 0.47s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-node-wrap { animation: tl-pop 0.40s var(--ap-ease) 0.74s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-node-wrap { animation: tl-pop 0.40s var(--ap-ease) 1.01s both; }

    .tl.in-view .tl-step:nth-child(1) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.30s both; }
    .tl.in-view .tl-step:nth-child(2) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.57s both; }
    .tl.in-view .tl-step:nth-child(3) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 0.84s both; }
    .tl.in-view .tl-step:nth-child(4) .tl-conn { animation: tl-fade 0.35s var(--ap-ease) 1.11s both; }

