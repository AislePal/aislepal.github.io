  .tl-card__name { font-size: var(--ap-fs-base); margin-bottom: 5px; }
  .tl-card__desc { font-size: 13px; }

  /* Day label: in-flow inside the header */
  .tl-day { position: static; transform: none; }

  .tl-card.is-active { transform: scale(1.02); }

  /* ── Scroll reveal (portrait) ── */
  @media (prefers-reduced-motion: no-preference) {
    .tl-node-wrap { opacity: 0; transform: scale(0.3); }
    .tl-conn { opacity: 0; }
    .tl-step .tl-card { opacity: 0; transform: translateY(14px); }
