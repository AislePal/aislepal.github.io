/* ═══════════════════════════════════════════════════════
   LANDSCAPE — horizontal spine · cards alternate ↑ / ↓
   ═══════════════════════════════════════════════════════ */
@media (orientation: landscape) {

  /* Unwrap the header so children are absolute-positioned relative to .tl-step */
  .tl-step-header { display: contents; }

  .tl-rail {
    top: 50%; transform: translateY(-1px);
    left: clamp(16px,4vw,48px); right: clamp(16px,4vw,48px);
