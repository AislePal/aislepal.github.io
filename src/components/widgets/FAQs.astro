---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Faqs as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-7xl mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} />
  <div class="max-w-4xl mx-auto divide-y divide-gray-200 dark:divide-slate-700">
    {
      items.map(({ title: question, description: answer }) => (
        <details class="faq-item group py-5">
          <summary class="flex cursor-pointer items-center justify-between gap-4 text-lg font-semibold text-gray-900 dark:text-white list-none [&::-webkit-details-marker]:hidden">
            <span set:html={question} />
            <span class="faq-chevron shrink-0 text-primary transition-transform duration-300">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="20"
                height="20"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </span>
          </summary>
          <div class="faq-body overflow-hidden">
            <div class="mt-3 pb-1 text-muted dark:text-slate-400" set:html={answer} />
          </div>
        </details>
      ))
    }
  </div>
</WidgetWrapper>

<script>
  document.querySelectorAll<HTMLDetailsElement>('details.faq-item').forEach((details) => {
    const summary = details.querySelector('summary')!;
    const body = details.querySelector<HTMLElement>('.faq-body')!;
    const chevron = summary.querySelector<HTMLElement>('.faq-chevron')!;
    let animation: Animation | null = null;

    summary.addEventListener('click', (e) => {
      e.preventDefault();

      if (animation) {
        animation.cancel();
        animation = null;
      }

      if (details.open) {
        // Closing
        chevron.style.transform = '';
        animation = body.animate(
          [
            { height: body.scrollHeight + 'px', opacity: '1' },
            { height: '0px', opacity: '0' },
          ],
          { duration: 300, easing: 'ease-out' }
        );
        animation.onfinish = () => {
          details.removeAttribute('open');
          animation = null;
        };
      } else {
        // Close any other open item first
        document.querySelectorAll<HTMLDetailsElement>('details.faq-item[open]').forEach((other) => {
          if (other === details) return;
          const otherBody = other.querySelector<HTMLElement>('.faq-body')!;
          const otherChevron = other.querySelector<HTMLElement>('.faq-chevron')!;
          otherChevron.style.transform = '';
          const close = otherBody.animate(
            [
              { height: otherBody.scrollHeight + 'px', opacity: '1' },
              { height: '0px', opacity: '0' },
            ],
            { duration: 300, easing: 'ease-out' }
          );
          close.onfinish = () => other.removeAttribute('open');
        });

        // Opening
        details.setAttribute('open', '');
        chevron.style.transform = 'rotate(180deg)';
        animation = body.animate(
          [
            { height: '0px', opacity: '0' },
            { height: body.scrollHeight + 'px', opacity: '1' },
          ],
          { duration: 300, easing: 'ease-out' }
        );
        animation.onfinish = () => {
          animation = null;
        };
      }
    });
  });
</script>
