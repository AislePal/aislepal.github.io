---
---

<section class="ts" data-reveal aria-label="Two sides of AislePal: shopper and store">
  <div class="ts-inner">

    <!-- column headers -->
    <div class="ts-heads ts-rise d0">
      <div class="ts-head">
        <span class="ts-eyebrow">For shoppers</span>
        <p class="ts-head__lede">Convenience that feels like online.</p>
      </div>
      <div></div>
      <div class="ts-head">
        <span class="ts-eyebrow">For your store</span>
        <p class="ts-head__lede">The intent layer e-commerce has had for 20 years.</p>
      </div>
    </div>

    <!-- Row 1: Discover → Search intelligence -->
    <div class="ts-row ts-rise d1">
      <div class="ts-cell ts-cell--shopper">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="8"/>
              <path d="m21 21-4.3-4.3"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Discover</h3>
            <p class="ts-feat__desc">Search naturally — "organic milk under $6." See what's in stock, ranked, and on promotion.</p>
          </div>
        </div>
      </div>

      <div class="ts-arrow" aria-hidden="true">
        <svg class="ts-arrow-svg" viewBox="0 0 88 24" fill="none">
          <line class="ts-arrow-line" x1="4" y1="12" x2="60" y2="12"/>
          <polyline class="ts-arrow-head" points="54,6 68,12 54,18"/>
          <circle class="ts-arrow-dot" cx="74" cy="12" r="2.5"/>
        </svg>
      </div>

      <div class="ts-cell ts-cell--store">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
              <polyline points="16 7 22 7 22 13"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Search intelligence</h3>
            <p class="ts-feat__desc">Know what shoppers wanted — including products you don't carry. Identify lost sales before they become lost customers.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 2: Navigate → Navigation patterns -->
    <div class="ts-row ts-rise d2">
      <div class="ts-cell ts-cell--shopper">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Navigate</h3>
            <p class="ts-feat__desc">Aisle-level guidance to every product. No more wandering, no more giving up.</p>
          </div>
        </div>
      </div>

      <div class="ts-arrow" aria-hidden="true">
        <svg class="ts-arrow-svg" viewBox="0 0 88 24" fill="none">
          <line class="ts-arrow-line" x1="4" y1="12" x2="60" y2="12"/>
          <polyline class="ts-arrow-head" points="54,6 68,12 54,18"/>
          <circle class="ts-arrow-dot" cx="74" cy="12" r="2.5"/>
        </svg>
      </div>

      <div class="ts-cell ts-cell--store">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polygon points="3 6 9 3 15 6 21 3 21 18 15 21 9 18 3 21"/>
              <line x1="9" x2="9" y1="3" y2="18"/>
              <line x1="15" x2="15" y1="6" y2="21"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Navigation patterns</h3>
            <p class="ts-feat__desc">See how shoppers actually move through the store. Where they slow down, where they give up. Optimize layout based on behavior.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Row 3: Check out → Demand forecasting -->
    <div class="ts-row ts-rise d3">
      <div class="ts-cell ts-cell--shopper">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="8" cy="21" r="1"/>
              <circle cx="19" cy="21" r="1"/>
              <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Check out</h3>
            <p class="ts-feat__desc">Optional in-aisle scan-and-pay. Skip the line. Faster trips, fuller carts.</p>
          </div>
        </div>
      </div>

      <div class="ts-arrow" aria-hidden="true">
        <svg class="ts-arrow-svg" viewBox="0 0 88 24" fill="none">
          <line class="ts-arrow-line" x1="4" y1="12" x2="60" y2="12"/>
          <polyline class="ts-arrow-head" points="54,6 68,12 54,18"/>
          <circle class="ts-arrow-dot" cx="74" cy="12" r="2.5"/>
        </svg>
      </div>

      <div class="ts-cell ts-cell--store">
        <div class="ts-feat">
          <div class="ts-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" x2="18" y1="20" y2="10"/>
              <line x1="12" x2="12" y1="20" y2="4"/>
              <line x1="6" x2="6" y1="20" y2="14"/>
            </svg>
          </div>
          <div class="ts-feat__body">
            <h3 class="ts-feat__name">Demand forecasting</h3>
            <p class="ts-feat__desc">Use search and browse signals to predict demand before it hits the register. Plan inventory on intent, not just history.</p>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  .ts {
    --ap-teal:            rgb(0 171 184);
    --ap-teal-700:        rgb(0 92 97);
    --ap-teal-50:         rgba(0, 171, 184, 0.07);
    --ap-teal-100:        rgba(0, 171, 184, 0.15);
    --ap-ink:             rgb(16 16 16);
    --ap-fg-2:            rgba(16, 16, 16, 0.62);
    --ap-border:          rgba(0, 0, 0, 0.1);
    --ap-r-sm:            6px;
    --ap-fs-xs:           0.75rem;
    --ap-fs-sm:           0.875rem;
    --ap-fs-base:         1rem;
    --ap-fw-medium:       500;
    --ap-fw-semibold:     600;
    --ap-tracking-eyebrow: 0.09em;
    --ap-tracking-tight:  -0.01em;
    --ap-lh-snug:         1.25;
    --ap-lh-loose:        1.6;
    --ap-dur:             150ms;
    --ap-dur-slow:        300ms;
    --ap-ease:            cubic-bezier(0.4, 0, 0.2, 1);

    padding-block: clamp(16px, 3vw, 32px);
    position: relative;
    overflow: hidden;
    container-type: inline-size;
    container-name: ts;
    font-family: 'Inter Variable', sans-serif;
    width: 80%;
    justify-self: center;
    border-radius: var(--ap-r-sm);
  }

  /* Sweeping gradient band */
  .ts::before {
    content: "";
    position: absolute; top: 0; bottom: 0; left: 0;
    width: 70%;
    background: linear-gradient(
      90deg,
      transparent          0%,
      rgba(0,171,184,0.03) 18%,
      rgba(0,171,184,0.08) 50%,
      rgba(0,171,184,0.03) 82%,
      transparent          100%
    );
    transform: translateX(-100%);
    animation: ts-sweep 5s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes ts-sweep {
    0%   { transform: translateX(-100%); }
    100% { transform: translateX(143%); }
  }

  .ts-inner {
    max-width: 1080px; margin: 0 auto;
    padding-inline: clamp(24px, 5vw, 64px);
    position: relative; z-index: 1;
  }

  /* Column headers */
  .ts-heads {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    padding-bottom: clamp(16px, 2vw, 24px);
    border-bottom: 1px solid var(--ap-border);
  }
  .ts-head { display: flex; flex-direction: column; gap: 5px; }

  .ts-eyebrow {
    display: inline-block;
    font-size: var(--ap-fs-xs); font-weight: var(--ap-fw-semibold);
    letter-spacing: var(--ap-tracking-eyebrow); text-transform: uppercase;
    color: var(--ap-teal-700);
  }

  .ts-head__lede {
    font-size: var(--ap-fs-sm); font-weight: var(--ap-fw-medium);
    line-height: var(--ap-lh-snug); color: var(--ap-fg-2);
    margin: 0; max-width: 26ch; text-wrap: pretty;
  }

  /* Feature rows */
  .ts-row {
    display: grid;
    grid-template-columns: 1fr 88px 1fr;
    padding-block: clamp(22px, 2.8vw, 34px);
    border-bottom: 1px solid var(--ap-border);
    transition: background var(--ap-dur) var(--ap-ease);
  }
  .ts-row:last-child { border-bottom: none; }
  .ts-row:hover { background: rgba(0, 171, 184, 0.04); }

  .ts-cell { display: flex; }
  .ts-cell--shopper { padding-right: 20px; }
  .ts-cell--store   { padding-left: 20px; }

  /* Animated arrow connector */
  .ts-arrow {
    display: flex; align-items: center; justify-content: center;
  }
  .ts-arrow-svg {
    width: 88px; height: 24px;
    display: block; overflow: visible;
  }

  .ts-arrow-line {
    fill: none;
    stroke: var(--ap-border);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 4 5;
    stroke-dashoffset: 0;
    animation: ts-march 1.2s linear infinite;
    transition: stroke var(--ap-dur-slow) var(--ap-ease);
  }

  .ts-arrow-head {
    fill: none;
    stroke: var(--ap-border);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke var(--ap-dur-slow) var(--ap-ease);
  }

  .ts-arrow-dot {
    fill: var(--ap-border);
    transition: fill var(--ap-dur-slow) var(--ap-ease);
  }

  .ts-row:hover .ts-arrow-line { stroke: var(--ap-teal); }
  .ts-row:hover .ts-arrow-head { stroke: var(--ap-teal); }
  .ts-row:hover .ts-arrow-dot  { fill:   var(--ap-teal); }

  @keyframes ts-march {
    to { stroke-dashoffset: -9; }
  }

  /* Feature items */
  .ts-feat { display: flex; gap: 14px; align-items: flex-start; }
  .ts-feat__body { flex: 1; display: flex; flex-direction: column; gap: 4px; }

  .ts-feat__name {
    font-size: var(--ap-fs-base); font-weight: var(--ap-fw-semibold);
    line-height: var(--ap-lh-snug); letter-spacing: var(--ap-tracking-tight);
    margin: 0; color: var(--ap-ink);
  }
  .ts-feat__desc {
    font-size: var(--ap-fs-sm); line-height: var(--ap-lh-loose);
    color: var(--ap-fg-2); margin: 0; text-wrap: pretty;
  }

  .ts-icon {
    flex-shrink: 0; width: 40px; height: 40px;
    border-radius: var(--ap-r-sm);
    background: var(--ap-teal-50); color: var(--ap-teal-700);
    display: grid; place-items: center;
    transition: background var(--ap-dur) var(--ap-ease);
  }
  .ts-icon svg { width: 20px; height: 20px; display: block; }
  .ts-row:hover .ts-icon { background: var(--ap-teal-100); }

  /* Scroll reveal */
  @keyframes ts-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ts .ts-rise { opacity: 0; transform: translateY(14px); }
    .ts.in-view .ts-rise { animation: ts-rise 0.55s var(--ap-ease) both; }
    .ts.in-view .ts-rise.d0 { animation-delay: 0.02s; }
    .ts.in-view .ts-rise.d1 { animation-delay: 0.10s; }
    .ts.in-view .ts-rise.d2 { animation-delay: 0.22s; }
    .ts.in-view .ts-rise.d3 { animation-delay: 0.34s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ts::before      { animation: none; opacity: 0; }
    .ts-arrow-line   { animation: none; }
  }

  /* Responsive */
  @container ts (max-width: 640px) {
    .ts-heads { grid-template-columns: 1fr; gap: 20px; }
    .ts-heads > :nth-child(2) { display: none; }
    .ts-row   { grid-template-columns: 1fr; gap: 0; }
    .ts-arrow { display: none; }
    .ts-cell--shopper { padding-right: 0; }
    .ts-cell--store   { padding-left: 0; padding-top: 14px; border-top: 1px dashed var(--ap-border); }
  }
</style>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function init(el: Element) {
      var done = false;
      function reveal() { if (done) return; done = true; el.classList.add('in-view'); cleanup(); }
      function inVp() { var r = el.getBoundingClientRect(), vh = window.innerHeight || document.documentElement.clientHeight; return r.top < vh * 0.85 && r.bottom > 0; }
      function check() { if (!done && inVp()) reveal(); }
      function cleanup() { window.removeEventListener('scroll', check); window.removeEventListener('resize', check); }
      window.addEventListener('scroll', check, { passive: true });
      window.addEventListener('resize', check);
      check(); setTimeout(check, 60);
      if (reduce) reveal();
    }
    function boot() { document.querySelectorAll('[data-reveal]').forEach(init); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  })();
</script>
