          <div class="flex items-center mb-6">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-green-100 dark:bg-green-900 mr-3">
              <Icon name="tabler:world" class="w-6 h-6 text-green-500 dark:text-green-300" />
