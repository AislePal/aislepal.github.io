---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Industries from '~/components/widgets/Industries.astro';
import { Icon } from 'astro-icon/components';
import dashboardMockup from '~/assets/images/dashboard_mockup.png';
import howItWorks from '~/assets/images/how_it_works.png';
import deploymentTimeline from '~/assets/images/deployment_timeline.png';
import erpIntegrations from '~/assets/images/ERP_integrations.png';

const metadata = {
  title: 'AislePal - Capture in-store intent. Increase sales in real time.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="THE IN-STORE INTELLIGENCE GAP"
    actions={[
      {
        variant: 'primary',
        text: 'Get Early Access',
        href: 'https://calendly.com/abdulla-aislepal/30min',
        target: '_blank',
        rel: 'noopener noreferrer',
      },
      {
        variant: 'secondary',
        text: 'See How it Works',
        href: 'https://calendly.com/abdulla-aislepal/30min',
        target: '_blank',
        rel: 'noopener noreferrer',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'AislePal Hero Image',
    }}
  >
    <Fragment slot="title">
      E-commerce platforms know what your customers want. Your store doesn't have to fall behind.
    </Fragment>

    <Fragment slot="subtitle">
      AislePal captures search behaviour, navigation patterns, and purchase intent inside your physical store giving you
      the same intelligence that powers online retail
    </Fragment>

    <Fragment slot="content">
      <div class="mt-6 flex flex-wrap gap-x-7 gap-y-3">
        {
          [
            { icon: 'tabler:device-mobile-filled', label: 'No app required' },
            { icon: 'tabler:barrier-block-filled', label: 'No hardware to install' },
            { icon: 'tabler:clock-filled', label: 'Live in 10-14 days' },
            { icon: 'tabler:key-filled', label: 'Integrates with existing POS/ERP' },
          ].map(({ icon, label }) => (
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 shrink-0 flex items-center justify-center bg-white rounded-full shadow-sm outline outline-[0.5px] outline-[#EBEBEB]">
                <Icon name={icon} class="text-gray-500 dark:text-slate-400 w-4 h-4" />
              </div>
              <span class="text-[#627678] text-base sm:text-lg font-medium">{label}</span>
            </div>
          ))
        }
      </div>
    </Fragment>
  </Hero>

  <!-- Visibility Gap Section ******************* -->
  <Content
    title="The <span class='text-gradient'>visibility gap</span> is growing"
    subtitle="Every online order generates behavioral data. Most in-store visits generate a receipt and nothing else."
  >
    <Fragment slot="content">
      <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-green-100 dark:bg-green-900 mr-3">
              <Icon name="tabler:world" class="w-6 h-6 text-green-500 dark:text-green-300" />
            </div>
            <h3 class="text-2xl font-semibold">What platforms learn</h3>
          </div>
          <div class="bg-lime-600/10 dark:bg-green-900/30 rounded-lg p-4 space-y-4">
            {
              [
                'Search queries and browse behavior',
                'Products viewed but not purchased',
                'Price sensitivity by category',
                'Substitution preferences',
                'Response to recommendations',
                'Cross-retailer purchase history',
              ].map((item) => (
                <div class="flex items-center gap-3">
                  <Icon name="tabler:circle-check-filled" class="text-green-500 shrink-0" />
                  <span>{item}</span>
                </div>
              ))
            }
          </div>
        </div>
        <div class="rounded-xl border border-gray-200 dark:border-slate-700 p-6 bg-white dark:bg-slate-900">
          <div class="flex items-center mb-6">
            <div class="w-10 h-10 flex items-center justify-center rounded-full bg-gray-200 dark:bg-slate-700 mr-3">
              <Icon name="tabler:world" class="w-6 h-6 text-gray-600 dark:text-gray-300" />
            </div>
            <h3 class="text-2xl font-semibold">What most stores learn</h3>
          </div>
          <div class="rounded-lg p-4 space-y-4">
            {
              ['Items purchased', 'Transaction total', 'Loyalty ID (if linked)'].map((item) => (
                <div class="flex items-center gap-3">
                  <Icon name="tabler:circle-check-filled" class="text-gray-800 dark:text-slate-300 shrink-0" />
                  <span>{item}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
      <div
        class="max-w-5xl mx-auto mt-6 rounded-lg px-4 py-3 flex items-center justify-center text-sm text-gray-600 dark:text-slate-300"
      >
        <Icon name="tabler:info-circle" class="mr-2 shrink-0" />
        <span>This gap compounds over time. Platforms get smarter with every transaction. Stores stay static.</span>
      </div>
    </Fragment>
  </Content>

  <!-- Hardware vs Data Section ******************* -->
  <Content isReversed={false} splitHalf={true}>
    <Fragment slot="title">
      The hardware approach didn't work. <span class="text-gradient">The data approach will.</span>
    </Fragment>
    <Fragment slot="image">
      <img
        src={dashboardMockup.src}
        alt="AislePal analytics and merchant dashboard"
        class="mx-auto w-full rounded-lg"
        style="background-color: white;"
        loading="lazy"
      />
    </Fragment>
    <Fragment slot="content">
      <p class="text-lg text-muted dark:text-slate-300 mb-6">
        Retailers invested heavily in cameras and sensors to understand behavior — but got high costs, privacy issues,
        and data that didn't drive action.
      </p>
      <p class="text-lg text-muted dark:text-slate-300 mb-8">
        Hardware tracks movement, not intent. Real insight comes from interaction: searches, navigation, and purchase
        paths. That's what fuels growth.
      </p>
      <div class="rounded-xl border border-[#4b9ea5]/30 bg-[#4b9ea5]/10 px-6 py-5">
        <p class="text-lg text-slate-700 dark:text-slate-200">
          <span class="font-semibold text-[#4b9ea5]">AislePal</span> works because it gives shoppers something valuable —
          search, navigation, and faster checkout — while generating insight as a byproduct.
        </p>
      </div>
    </Fragment>
  </Content>

  <!-- HOW IT WORKS Section ******************* -->
  <Content
    id="how-it-works"
    tagline="HOW IT WORKS"
    title="One scan. <span class='text-gradient'>Complete visibility.</span>"
    subtitle="AislePal delivers a simple QR-based web experience for shoppers — no app required — while capturing the behavioral data you need to compete."
  >
    <Fragment slot="image">
      <img
        src={howItWorks.src}
        alt="AislePal how it works — four steps"
        class="mx-auto w-full rounded-lg"
        loading="lazy"
      />
    </Fragment>
  </Content>

  <!-- Analytics Features Section ******************* -->
  <Features
    id="features"
    tagline="Aisle Analytics"
    title="See what you've been <span class='text-gradient'>missing</span>"
    subtitle="AislePal Analytics turns in-store behavior into actionable insight."
    columns={3}
    items={[
      {
        title: 'Search Intelligence',
        description:
          "Know exactly what customers are looking for — including products you don't carry yet. Identify demand gaps before they become lost sales.",
        icon: 'tabler:search',
      },
      {
        title: 'Conversion Tracking',
        description:
          'See the journey from search to shelf to checkout. Understand where customers convert, abandon, or substitute.',
        icon: 'tabler:eye',
      },
      {
        title: 'Out-of-Stock Impact',
        description:
          "Measure the real cost of stockouts. See what customers searched for, couldn't find, and what they did next.",
        icon: 'tabler:shopping-cart-off',
      },
      {
        title: 'Navigation Patterns',
        description:
          'Understand how customers move through your store. Identify high-traffic zones and optimize product placement.',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Promotion Performance',
        description:
          'Track promotion engagement from impression to purchase. Know which offers drive action and which get ignored.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Demand Forecasting',
        description:
          'Use search and browse data to predict demand before it shows up at the register. Plan inventory based on intent, not just history.',
        icon: 'tabler:chart-bar',
      },
    ]}
  />

  <!-- Results Section ******************* -->
  <Stats
    id="results"
    tagline="Results"
    title="The <span class='text-gradient'>financial case</span>"
    stats={[
      { title: 'Expected NPS lift', amount: '15 pt.' },
      { title: 'FTE efficiency gain', amount: '10%' },
      { title: 'Revenue Lift', amount: '3.4%' },
      { title: 'Pilot ROI Multiple', amount: '6.5x' },
    ]}
  />

  <!-- Deployment Timeline Section ******************* -->
  <Content
    id="setup"
    tagline="Deployment"
    title="Live in two weeks. <span class='text-gradient'>No construction required.</span>"
    subtitle="AislePal deploys without hardware installation or store modifications."
  >
    <Fragment slot="image">
      <img
        src={deploymentTimeline.src}
        alt="AislePal deployment timeline — Setup, Integration, Customization, Deployment over 14 days"
        class="mx-auto w-full rounded-lg"
        loading="lazy"
      />
    </Fragment>
  </Content>

  <!-- Integrations Section ******************* -->
  <Content
    id="integrations"
    isReversed
    tagline="Integrations"
    title="Integrates with your <span class='text-gradient'>existing systems</span>"
    subtitle="Fully deployed in 14 days. No store closures. No construction. No IT projects that drag on for months."
  >
    <Fragment slot="image">
      <img
        src={erpIntegrations.src}
        alt="AislePal integration diagram"
        class="mx-auto w-full rounded-lg"
        loading="lazy"
      />
    </Fragment>
  </Content>

  <!-- Industries Section ******************* -->
  <Industries
    id="industries"
    tagline="Industries"
    title="Who we're <span class='text-gradient'>built for</span>"
    subtitle=""
    industries={[
      { name: 'Grocery', image: '~/assets/images/industries/supermarket-aisle.jpg' },
      { name: 'Big Box', image: '~/assets/images/industries/big-box.png' },
      { name: 'Department', image: '~/assets/images/industries/department.png' },
      { name: 'Pharmacy', image: '~/assets/images/industries/pharmacy.png' },
      { name: 'Specialty', image: '~/assets/images/industries/speciality.png' },
    ]}
  />

  <!-- FAQs Section ******************* -->
  <FAQs
    id="faq"
    tagline="FAQ"
    title="Frequently asked <span class='text-gradient'>questions</span>"
    subtitle="Common questions from retail decision-makers evaluating AislePal."
    columns={1}
    classes={{ container: 'max-w-4xl' }}
    items={[
      {
        title: 'Do my customers need to download an app?',
        description:
          'No. AislePal runs entirely in the mobile web browser. Customers scan a QR code and immediately access the experience — no app store, no account creation, no friction.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'What data do you collect?',
        description:
          'AislePal collects anonymous behavioral data: search queries, product views, navigation patterns, and purchase signals. No personal identifiers are stored. The platform is CCPA/GDPR aligned with privacy-first design.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'How does AislePal integrate with our existing systems?',
        description:
          'AislePal connects to your POS, ERP, and inventory systems through pre-built connectors for SAP, Oracle, Microsoft Dynamics, and others. Most integrations are completed within the first week of deployment.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'What if QR adoption is low in my stores?',
        description:
          'Even with partial adoption, AislePal delivers meaningful data. A 10–20% scan rate in a high-traffic store generates thousands of behavioral data points per day — more than most loyalty programs capture in a month.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'Is there still value if only a portion of customers use it?',
        description:
          'Yes. The insights you gain from early adopters are statistically representative of broader shopping behavior. And as customers discover the benefit of instant product search, adoption typically grows organically.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'How does this work with our existing loyalty program?',
        description:
          'AislePal is complementary to loyalty programs. It captures intent signals from shoppers regardless of whether they are enrolled in your loyalty program, and can be integrated to enrich loyalty profiles over time.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'Does this add work for our cashiers?',
        description:
          'No. AislePal is designed to reduce friction — not add it. The shopping experience is fully self-serve, and optional mobile checkout is handled by the shopper. Cashiers see no change to their workflow.',
        icon: 'tabler:chevron-down',
      },
      {
        title: 'Are there concerns about theft with mobile checkout?',
        description:
          "AislePal's optional mobile checkout includes audit and reconciliation tools. Loss prevention features like anomaly detection and real-time cart visibility actually reduce shrink compared to standard checkout flows.",
        icon: 'tabler:chevron-down',
      },
      {
        title: 'What if we want to cancel?',
        description:
          'No long-term lock-in. We work on flexible contracts and will work with you to ensure a smooth offboarding if needed.',
        icon: 'tabler:chevron-down',
      },
    ]}
  />

  <!-- CallToAction Widget *********** -->
  <CallToAction
    id="contact"
    actions={[
      {
        variant: 'primary',
        text: 'Book a Demo',
        href: 'https://calendly.com/abdulla-aislepal/30min',
        icon: 'tabler:calendar',
      },
    ]}
  >
    <Fragment slot="title">
      Bring platform level intelligence to your <span class="text-gradient">physical store.</span>
    </Fragment>
    <Fragment slot="subtitle">
      <span class="text-gradient">Own</span> the data. <span class="text-gradient">Own</span> the experience. <span
        class="text-gradient">Own</span
      > the future.
    </Fragment>
  </CallToAction>
</Layout>
