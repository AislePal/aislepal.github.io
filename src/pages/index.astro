---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Stats from '~/components/widgets/Stats.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Industries from '~/components/widgets/Industries.astro';
import { Icon } from 'astro-icon/components';
import dashboardMockup from '~/assets/images/dashboard_mockup.png';
import howItWorks from '~/assets/images/how_it_works.png';
import deploymentTimeline from '~/assets/images/deployment_timeline.png';
import erpIntegrations from '~/assets/images/ERP_integrations.png';

const metadata = {
  title: 'AislePal — Lift sales today. Capture intent forever.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->
  <Hero
    tagline="THE IN-STORE INTELLIGENCE LAYER"
    actions={[
      {
        variant: 'primary',
        text: 'Book a Demo',
        href: 'https://calendly.com/abdulla-aislepal/30min',
        target: '_blank',
        rel: 'noopener noreferrer',
      },
      {
        variant: 'secondary',
        text: 'Join a Pilot',
        href: 'https://calendly.com/abdulla-aislepal/30min',
        target: '_blank',
        rel: 'noopener noreferrer',
      },
    ]}
    image={{
      src: '~/assets/images/hero-image.png',
      alt: 'AislePal Hero Image',
    }}
  >
    <Fragment slot="title">
      Lift sales <span class="text-gradient">today</span>. <br />Capture intent <span class="text-gradient">forever</span>
    </Fragment>

    <Fragment slot="subtitle">
      AislePal gives shoppers a faster, easier way to find what they want — and turns every search, scan, and step into the intent data your store has never had.
    </Fragment>

    <Fragment slot="content">
      <div class="mt-6 flex flex-wrap gap-x-7 gap-y-3 justify-center">
        {
          [
            { icon: 'tabler:device-mobile-filled', label: 'No app' },
            { icon: 'tabler:barrier-block-filled', label: 'No hardware' },
            { icon: 'tabler:clock-filled', label: 'Live in 14 days' },
            { icon: 'tabler:key-filled', label: 'POS / ERP ready' },
          ].map(({ icon, label }) => (
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 shrink-0 flex items-center justify-center bg-white rounded-full shadow-sm outline outline-[0.5px] outline-[#EBEBEB]">
                <Icon name={icon} class="text-gray-500 dark:text-slate-400 w-4 h-4" />
              </div>
              <span class="text-[#627678] text-base sm:text-lg font-medium">{label}</span>
            </div>
          ))
        }
      </div>
    </Fragment>
  </Hero>

  <!-- Visibility Gap Section ******************* -->
